{
  "name": "noname",
  "private": true,
  "version": "0.0.1",
  "description": "AI-native, declarative full-stack platform. Describe what you want -> AI generates a spec -> spec executes across UI (json-render), backend (XState), and integrations (Nango). Generative content, generative UI, generative logic. Identity-agnostic base — commerce is a Phase 3 use case, not the platform identity.",
  "scripts": {
    "dev": "pnpm --filter @noname/server dev",
    "build": "pnpm -r build",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "fix": "biome check --write",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx scripts/seed/demo.ts",
    "seed:demo:commerce": "tsx scripts/seed/demo-commerce.ts",
    "deploy:client-r2": "tsx scripts/deploy/client-r2.ts",
    "init:zitadel": "tsx scripts/init/zitadel-oidc.ts",
    "start:all": "pm2 start ecosystem.config.js",
    "start:all:logs": "pm2 logs",
    "start:all:status": "pm2 status",
    "start:all:monit": "pm2 monit",
    "start:all:restart": "pm2 restart ecosystem.config.js",
    "start:all:delete": "pm2 delete ecosystem.config.js",
    "stop:all": "pm2 delete ecosystem.config.js || echo 'No pm2 processes'",
    "stop:all:kill": ". .\\.tools\\stop-all.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.2.3",
    "tsx": "^4.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "pm2": "^7.0.3"
  }
}
