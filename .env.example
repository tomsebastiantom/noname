# Database
POSTGRES_PASSWORD=noname_dev
DATABASE_URL=postgres://noname:noname_dev@localhost:5432/app

# Redis (Dragonfly via Podman — `podman compose up dragonfly`)
# BullMQ requires Dragonfly flags: --cluster_mode=emulated --lock_on_hashtags (see docker-compose.yml)
REDIS_URL=redis://localhost:6379

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123

# Auth (ZITADEL) — JWT validated at edge worker; API server trusts HMAC headers from worker.
# Run: pnpm init:zitadel  (writes ZITADEL_CLIENT_ID + ZITADEL_DEMO_ORG_ID to .env)
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_CLIENT_ID=
# ZITADEL org id — used as org_id for local demo (seed + client subdomain)
ZITADEL_DEMO_ORG_ID=
# Machine key for Management API (admin Google IdP registration). init:zitadel writes
# zitadel_keys/noname-backend-sa.json — or set ZITADEL_MACHINE_KEY_PATH / ZITADEL_MACHINE_KEY_JSON.
# After `podman compose down -v`, run `pnpm init:zitadel` (do not keep old zitadel_keys/ — script refreshes automatically).
# Optional — seed-only: pre-populate Postgres idpIds if you already created Google IdP in ZITADEL console.
# Runtime never reads this; admin Save registers IdP via Management API.
ZITADEL_GOOGLE_IDP_ID=
# Must match packages/workers/.dev.vars (edge HMAC signing)
WORKER_SERVER_SECRET=change-me-in-production
# Local dev: allow seed + direct :3000 without edge HMAC (ignored in production)
REQUIRE_EDGE_HMAC=false
# Local dev only — allow direct :3000 API without edge HMAC (ignored when NODE_ENV=production)
REQUIRE_EDGE_HMAC=false
# Production: do not set REQUIRE_EDGE_HMAC=false; unsigned requests are rejected when WORKER_SERVER_SECRET is set

# Ory Keto (Zanzibar document scope — server-only, not edge; always enforced)
# Keto must be running (podman compose up keto). Local defaults match compose ports.
KETO_READ_URL=localhost:4466
KETO_WRITE_URL=localhost:4467
# Production: omit KETO_GRPC_INSECURE; use TLS/mTLS on internal network instead.
# Local dev only — plaintext gRPC to localhost Keto (same idea as REQUIRE_EDGE_HMAC=false).
KETO_GRPC_INSECURE=true

# Demo team users — created by pnpm seed:demo (ZITADEL + Keto scope testing)
# ZITADEL_DEMO_EDITOR_EMAIL=editor@zitadel.localhost
# ZITADEL_DEMO_EDITOR_PASSWORD=NonameEditor1!
# ZITADEL_DEMO_MARKETING_EMAIL=marketing@zitadel.localhost
# ZITADEL_DEMO_MARKETING_PASSWORD=NonameMarketing1!
# Optional — override marketing user's Keto sub (seed:demo logs in as marketing@… by default)
# DEMO_SCOPE_EDITOR_SUB=

NANGO_DB_PASSWORD=nango_dev
NANGO_SECRET_KEY=dev_secret_key

# LLM (OpenAI / Claude)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
