# Local S3 emulator (s3rver) config — see ../../docker-compose.yml.
# Copy to .env next to this file, or export these before `pnpm dev`.
R2_BUCKET=noname-assets
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=S3RVER
R2_SECRET_ACCESS_KEY=S3RVER
R2_PUBLIC_URL=http://localhost:9000/noname-assets
R2_REGION=us-east-1

# Auth (ZITADEL) — JWT validated at edge worker; server verifies the edge HMAC.
# Strict enforcement: a request without a valid HMAC is rejected. There is no
# bypass flag — the API is never reachable directly, in dev or production.
# ZITADEL_ISSUER / ZITADEL_CLIENT_ID / ZITADEL_PROJECT_ID live in the repository
# root .env only (written by `pnpm init:zitadel`). Do NOT duplicate them here:
# the server loads the root .env first, and a stale duplicate silently shadowed
# it once already, rejecting every valid access token.
WORKER_SERVER_SECRET=change-me-in-production

# LOCAL DEV ONLY — leave unset everywhere else.
# When the configured ZITADEL_PROJECT_ID yields no roles, scan every
# `urn:zitadel:iam:org:project:*:roles` claim in the token. Role names are not
# namespaced per project, so this lets a role called `admin` in an unrelated
# project read as the platform `admin`. It exists to survive a stale local
# ZITADEL_PROJECT_ID. Ignored when NODE_ENV=production (the guard wins), but do
# not rely on that in a deployed environment: leave it unset there.
# ZITADEL_ALLOW_PROJECT_ID_FALLBACK=true

# HashiCorp Vault — BYOK (compose: vault on :8200)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_MOUNT=secret
VAULT_PATH_PREFIX=noname

# ---- Production (Cloudflare R2) — replace the block above with: ----
# R2_BUCKET=noname-assets
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=real-r2-access-key
# R2_SECRET_ACCESS_KEY=real-r2-secret
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pub-<hash>.r2.dev
# R2_REGION=auto
