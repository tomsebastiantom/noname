# Local S3 emulator (s3rver) config — see ../../docker-compose.yml.
# Copy to .env next to this file, or export these before `pnpm dev`.
R2_BUCKET=noname-assets
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=dummy
R2_SECRET_ACCESS_KEY=dummy
R2_PUBLIC_URL=http://localhost:9000/noname-assets
R2_REGION=us-east-1

# ---- Production (Cloudflare R2) — replace the block above with: ----
# R2_BUCKET=noname-assets
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=real-r2-access-key
# R2_SECRET_ACCESS_KEY=real-r2-secret
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pub-<hash>.r2.dev
# R2_REGION=auto
