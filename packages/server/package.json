{
  "name": "@noname/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "biome lint",
    "format": "biome format --write",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.50.0",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/client-ses": "^3.1104.0",
    "@clickhouse/client": "^1.0.0",
    "@hono/node-server": "^2.0.0",
    "@json-render/core": "^0.19.0",
    "@json-render/react-email": "^0.19.0",
    "@mastra/core": "^1.57.0",
    "@module-federation/enhanced": "^2.7.0",
    "@module-federation/runtime": "^2.7.0",
    "@nangohq/node": "^0.71.3",
    "@noname/auth": "workspace:*",
    "@noname/documents": "workspace:*",
    "@noname/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace": "^2.9.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@rspack/core": "^2.1.0",
    "bullmq": "^5.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.0.0",
    "ioredis": "^5.4.0",
    "memfs": "^4.0.0",
    "openai": "^5.0.0",
    "postgres": "^3.4.0",
    "xstate": "^5.31.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@automerge/automerge": "^3.4.0",
    "@types/node": "^26.0.0",
    "drizzle-kit": "^0.31.0",
    "loro-crdt": "^1.13.9",
    "tsx": "^4.0.0",
    "typescript": "^7.0.0"
  }
}
