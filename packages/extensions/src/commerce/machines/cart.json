{
  "name": "cart",
  "initial": "active",
  "states": {
    "active": {
      "on": {
        "addToCart": { "target": "active" },
        "clear": { "target": "active" },
        "checkout_started": { "target": "awaiting_payment" },
        "checkout": { "target": "awaiting_payment" },
        "claim": { "target": "active" }
      }
    },
    "awaiting_payment": {
      "on": {
        "PAYMENT_SUCCEEDED": { "target": "paid" },
        "PAYMENT_FAILED": { "target": "payment_failed" }
      }
    },
    "paid": { "final": true },
    "payment_failed": { "final": true }
  }
}
