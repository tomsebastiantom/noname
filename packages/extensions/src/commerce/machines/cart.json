{
  "name": "cart",
  "initial": "active",
  "states": {
    "active": {
      "on": {
        "addToCart": { "target": "active" },
        "clear": { "target": "active" },
        "checkout_reserving": { "target": "checkout_pending" },
        "checkout": { "target": "awaiting_payment" },
        "claim": { "target": "active" }
      }
    },
    "checkout_pending": {
      "on": { "checkout_started": { "target": "awaiting_payment" } }
    },
    "awaiting_payment": {
      "on": {
        "PAYMENT_SUCCEEDED": {
          "target": "paid",
          "guard": { "type": "commerce.payment.matches-checkout" }
        },
        "PAYMENT_FAILED": { "target": "payment_failed" }
      }
    },
    "paid": {
      "on": {
        "CANCEL_ORDER": { "target": "cancelled" },
        "MARK_FULFILLED": { "target": "fulfilled" },
        "REFUND_ORDER": { "target": "refund_pending" }
      }
    },
    "refund_pending": {
      "on": {
        "REFUND_CONFIRMED": { "target": "refunded" },
        "REFUND_FAILED": { "target": "paid" }
      }
    },
    "cancelled": { "final": true },
    "fulfilled": { "final": true },
    "refunded": { "final": true },
    "payment_failed": { "final": true }
  }
}
